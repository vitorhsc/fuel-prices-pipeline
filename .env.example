# Copy to .env and adjust. Never commit the real .env file.
# Docker Compose and the Makefile read it automatically. The DGEG API is public: no API key needed.

# Host port of the Docker PostgreSQL. Change it if 5432 is already in use on your machine
# (e.g. a local PostgreSQL install), and use the same port in DATABASE_URL below.
POSTGRES_PORT=5432

# Used when running the pipeline outside Docker
DATABASE_URL=postgresql://pipeline:pipeline@localhost:5432/analytics

# Optional overrides
# PIPELINE_CONFIG=config/pipeline.yaml
# PARQUET_DIR=data/raw
